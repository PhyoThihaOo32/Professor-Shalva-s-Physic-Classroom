DATABASE_URL="postgresql://chalklight:CHANGE_ME@localhost:5432/chalklight"
# For hosted Postgres, optionally use an unpooled connection for migrations.
# DIRECT_DATABASE_URL="postgresql://..."
APP_ORIGIN="http://127.0.0.1:3000"
GUEST_COOKIE_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
COOKIE_SECURE="false"
AUTH_URL="http://127.0.0.1:3000"
AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_OWNER_GITHUB_ID=""
# Optional: set AI_KEY_ENCRYPTION_SECRET to a separate random secret of at least 32 characters.
# If absent, personal-key encryption derives from GUEST_COOKIE_SECRET.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
ALLOW_LIVE_AI="false"
SESSION_STARTS_PER_HOUR="10"
MAX_MODEL_CALLS_PER_SESSION="20"
# Conservative reservation per call. Adjust to the chosen model's upper-bound token price.
MODEL_CALL_RESERVATION_CENTS="50"
SESSION_SPEND_LIMIT_CENTS="1000"
DAILY_SPEND_LIMIT_CENTS="2000"
GUEST_RETENTION_DAYS="30"
